# syntax=docker/dockerfile:1
# Multi-stage build for the weaver benchmark environment.
# Stage 1 (builder) compiles both ferro-hgvs and weaver from source.
# Stage 2 (runtime) is the lean image used to run the validation and ferro prepare.

# ── builder ──────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        git \
        patchelf \
        pkg-config \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust via rustup
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

# maturin builds the Python wheels; uv exports the validation's dependencies from the lock.
RUN pip install --no-cache-dir maturin uv

# ── ferro-hgvs: Python wheel + CLI binary ────────────────────────────────────
RUN git clone --depth 1 --recurse-submodules --shallow-submodules \
        https://github.com/fulcrumgenomics/ferro-hgvs.git /build/ferro-hgvs

# Python wheel (for ferro_hgvs Python bindings)
RUN cd /build/ferro-hgvs && maturin build --release --out /wheels

# CLI binary (for `ferro prepare` / `ferro normalize`)
RUN cd /build/ferro-hgvs && cargo build --release --bin ferro
RUN cp /build/ferro-hgvs/target/release/ferro /usr/local/bin/ferro

# ── weaver: Python wheel ──────────────────────────────────────────────────────
COPY . /build/hgvs-rs
RUN cd /build/hgvs-rs && maturin build --release --out /wheels
# The gate group, as locked: the lock's override leaves out hgvs's database driver, which needs libpq to build.
RUN cd /build/hgvs-rs && uv export --locked --no-dev --group gate --no-emit-project --no-hashes \
        --output-file /wheels/gate-requirements.txt

# ── runtime ──────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        libbz2-dev \
        liblzma-dev \
        libcurl4 \
    && rm -rf /var/lib/apt/lists/*

# Bring in compiled artifacts from builder
COPY --from=builder /wheels /wheels
COPY --from=builder /usr/local/bin/ferro /usr/local/bin/ferro

# --no-deps: the export is the whole locked closure; pip resolving it again would bring the overridden
# packages back.
RUN pip install --no-cache-dir --no-deps -r /wheels/gate-requirements.txt /wheels/hgvs_weaver-*.whl \
    && pip install --no-cache-dir /wheels/ferro_hgvs-*.whl

# Reference data and input files are mounted at runtime.
WORKDIR /data

ENTRYPOINT ["python", "-m", "weaver.cli.validate"]
